# Compatible with HIP / ROCm 10.x
set(PACKAGE_VERSION "10.1.0")
if(PACKAGE_FIND_VERSION_MAJOR EQUAL 10)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
else()
  if(PACKAGE_FIND_VERSION VERSION_LESS "11.0.0" AND PACKAGE_FIND_VERSION VERSION_GREATER_EQUAL "10.0.0")
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  else()
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  endif()
endif()
