# Compatible with HIP / ROCm 7.x
set(PACKAGE_VERSION "7.14.0")
if(PACKAGE_FIND_VERSION_MAJOR EQUAL 7)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
else()
  # Same major as CMake SameMajorVersion for 7
  if(PACKAGE_FIND_VERSION VERSION_LESS "8.0.0" AND PACKAGE_FIND_VERSION VERSION_GREATER_EQUAL "7.0.0")
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  else()
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  endif()
endif()
